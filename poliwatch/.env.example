# Required
CONGRESS_API_KEY=your_key_here

# Optional
PROPUBLICA_API_KEY=your_key_here
OPENSECRETS_API_KEY=your_key_here

# Database (defaults to SQLite)
DATABASE_URL=sqlite+aiosqlite:///./poliwatch.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/poliwatch

# Alerts
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=you@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password

# Optional webhooks
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Thresholds
SUSPICION_ALERT_THRESHOLD=60
DATA_REFRESH_INTERVAL_HOURS=6
